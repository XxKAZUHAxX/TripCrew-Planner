# Server configuration
PORT=5000
MONGODB_URI=
JWT_SECRET=
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5173

# Cloudflare R2 (S3-compatible) storage for destination photo uploads (Feature 6).
# Leave blank to disable uploads (the API returns 503 for photo uploads).
R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=tripcrewplanner
# Public base URL for the bucket (r2.dev subdomain or a custom domain), no trailing slash.
R2_PUBLIC_BASE_URL=

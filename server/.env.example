# Server configuration
PORT=5000
MONGODB_URI=
JWT_SECRET=
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5173

# Cloudflare R2 (S3-compatible) storage for destination photo uploads (Feature 6).
# Leave blank to disable uploads (the API returns 503 for photo uploads).
R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=tripcrewplanner
# Public base URL for the bucket (r2.dev subdomain or a custom domain), no trailing slash.
R2_PUBLIC_BASE_URL=

# Shared secret for POST /api/maintenance/cleanup (Feature 8: stale-data cleanup).
# Leave blank to disable the endpoint entirely (returns 503). Set this and call the
# endpoint periodically (e.g. a scheduled GitHub Actions workflow) with header
# `x-maintenance-key: <value>` — the app also runs one best-effort pass on boot.
MAINTENANCE_SECRET=

{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],

    "allowJs": true,
    "checkJs": false,

    "strict": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["vite.config.js", "vitest.config.ts"]
}

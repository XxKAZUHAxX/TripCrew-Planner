{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "lib": ["ES2023"],

        "strict": true,
        "noUncheckedIndexedAccess": true,

        "declaration": true,
        "outDir": "dist",
        "rootDir": "src",
        "sourceMap": true,

        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true
    },
    "include": ["src"],
    "exclude": ["node_modules", "dist"]
}
